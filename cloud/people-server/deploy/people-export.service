[Unit]
Description=People server weekly training export
After=docker.service
OnFailure=people-notify@%n.service

[Service]
Type=oneshot
User=people
Group=people
EnvironmentFile=/etc/people/people.env
ExecStart=/opt/people/bin/bun /opt/people/current/people-export.js
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Bun's JIT needs writable+executable memory.
MemoryDenyWriteExecute=no
CapabilityBoundingSet=
MemoryMax=512M
