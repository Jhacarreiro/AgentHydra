[Unit]
Description=AgentHydra people server
After=network-online.target docker.service
Wants=network-online.target
OnFailure=people-notify@%n.service

[Service]
User=people
Group=people
EnvironmentFile=/etc/people/people.env
# Pinned bun, copied to a root-owned path by the deploy; the bundle is one file.
ExecStart=/opt/people/bin/bun /opt/people/current/people-server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# Bun's JIT needs writable+executable memory, so this must stay off.
MemoryDenyWriteExecute=no
CapabilityBoundingSet=
SystemCallFilter=@system-service
MemoryMax=512M
TasksMax=256
# State lives in Postgres: no ReadWritePaths.

[Install]
WantedBy=multi-user.target
