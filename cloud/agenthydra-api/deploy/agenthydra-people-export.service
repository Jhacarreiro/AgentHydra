[Unit]
Description=AgentHydra API weekly training export
After=docker.service
OnFailure=agenthydra-notify@%n.service

[Service]
Type=oneshot
User=agenthydra
Group=agenthydra
EnvironmentFile=/etc/agenthydra/api.env
ExecStart=/opt/agenthydra-api/bin/bun /opt/agenthydra-api/current/people-export.js
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Bun's JIT needs writable+executable memory.
MemoryDenyWriteExecute=no
CapabilityBoundingSet=
MemoryMax=512M
