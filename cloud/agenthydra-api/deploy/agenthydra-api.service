[Unit]
Description=AgentHydra API
After=network-online.target docker.service
Wants=network-online.target
OnFailure=agenthydra-notify@%n.service

[Service]
User=agenthydra
Group=agenthydra
EnvironmentFile=/etc/agenthydra/api.env
# Pinned bun, copied to a root-owned path by the deploy; the bundle is one file.
ExecStart=/opt/agenthydra-api/bin/bun /opt/agenthydra-api/current/agenthydra-api.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# Bun's JIT needs writable+executable memory, so this must stay off.
MemoryDenyWriteExecute=no
CapabilityBoundingSet=
SystemCallFilter=@system-service
MemoryMax=512M
TasksMax=256
# State lives in Postgres: no ReadWritePaths.

[Install]
WantedBy=multi-user.target
