# Copy to /etc/agenthydra/backup.env (root, 0600). Placeholders only; never commit real values.
# Private S3 bucket that receives the encrypted dumps (versioning on, 35-day lifecycle).
AGENTHYDRA_BACKUP_BUCKET=example-agenthydra-backups
# AWS region of that bucket.
AGENTHYDRA_BACKUP_REGION=us-east-1
# Optional key prefix inside the bucket.
AGENTHYDRA_BACKUP_PREFIX=agenthydra-api
# age recipient (PUBLIC key, starts with age1...). Used when `age` is installed.
AGENTHYDRA_BACKUP_AGE_RECIPIENT=age1exampleexampleexampleexampleexampleexampleexampleexample
# Fallback when age is missing: path to the owner's PUBLIC gpg key file (imported into a temp keyring).
AGENTHYDRA_BACKUP_GPG_PUBKEY_FILE=/etc/agenthydra/backup-public.gpg
# Recipient id (fingerprint) of that gpg key.
AGENTHYDRA_BACKUP_GPG_RECIPIENT=OWNER_KEY_FINGERPRINT
# AWS shared-credentials file holding the PutObject-only IAM user (root, 0600).
AGENTHYDRA_BACKUP_AWS_CREDENTIALS_FILE=/etc/agenthydra/aws-credentials
# Profile name inside that credentials file.
AGENTHYDRA_BACKUP_AWS_PROFILE=agenthydra-backup
